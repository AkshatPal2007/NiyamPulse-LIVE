# Server-side integration only. Keep .env private.
SARVAM_API_KEY=
NIYAMPULSE_WEB_MONITOR=1
NIYAMPULSE_DATA_DIR=var/production
NIYAMPULSE_V2_DEMO=0
# Native local HTTP. Public hosting requires production + a canonical HTTPS URL.
NIYAMPULSE_ENV=local
NIYAMPULSE_PUBLIC_URL=http://127.0.0.1:8000
# Production only: set 1 after verifying persistent storage and use an absolute data path.
NIYAMPULSE_STORAGE_DURABLE=0
# Render persistent disk mount; only applicable when deploying there.
# NIYAMPULSE_PERSISTENT_ROOT=/var/data
# Real SMTP credentials; STARTTLS (587) or implicit TLS (465).
# Authenticated SMTP needs both username and password. See docs/PRODUCTION_SETUP.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# The existing persistent Sarvam cap and 500-credit reserve are not reset here.
